INMET_ALERTS_URL=https://apiprevmet3.inmet.gov.br/avisos/ativos
WIS2_SYNOP_URL=https://wis2bra.inmet.gov.br/oapi/collections/urn:wmo:md:br-inmet:synop/items
HTTP_TIMEOUT_SECONDS=10
STATION_SEARCH_DELTA_DEGREES=0.5
INSURED_DATASET_PATH=data/insureds.json
WEATHER_EXPOSURE_RADIUS_KM=25

# Thresholds for event detection from observations.
HEAVY_RAIN_RATE_MM_PER_HOUR=20
HEAVY_RAIN_DAILY_MM=50
HEAVY_RAIN_HIGH_RATE_MM_PER_HOUR=50
HEAVY_RAIN_EXTREME_RATE_MM_PER_HOUR=80
HEAVY_RAIN_HIGH_DAILY_MM=100
HEAVY_RAIN_EXTREME_DAILY_MM=150
STRONG_WIND_SPEED_KMH=60
STRONG_WIND_HIGH_KMH=80
STRONG_WIND_EXTREME_KMH=100

# Grok (x.ai) — usado exclusivamente para gerar/personalizar as mensagens.
# Sem chave, o sistema usa o gerador determinístico de templates.
GROK_API_KEY=
GROK_MODEL=grok-4-fast-non-reasoning
GROK_BASE_URL=https://api.x.ai/v1

# Caminho do log do envio simulado das notificações.
SENT_NOTIFICATIONS_PATH=artifacts/sent_notifications.json
